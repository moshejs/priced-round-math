{
  "name": "priced-round-math",
  "version": "1.0.0",
  "description": "Priced venture-round dilution math — the option-pool shuffle (solve the pre-money pool top-up for a post-close target), price per share, investor shares, ownership tables. Zero dependencies.",
  "keywords": ["cap-table", "dilution", "option-pool", "option-pool-shuffle", "venture-capital", "startup", "priced-round", "pre-money", "post-money", "equity", "finance"],
  "homepage": "https://moshemalka.com",
  "repository": { "type": "git", "url": "git+https://github.com/moshejs/priced-round-math.git" },
  "bugs": "https://github.com/moshejs/priced-round-math/issues",
  "author": "Moshe Malka <hello@moshemalka.com> (https://moshemalka.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": { "tsup": "^8.5.0", "typescript": "^5.8.0", "vitest": "^3.2.0" },
  "engines": { "node": ">=18" }
}
